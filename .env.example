# PayPal Configuration
# Get these from https://developer.paypal.com/dashboard/

# PayPal API Mode: sandbox or live
PAYPAL_MODE=sandbox

# PayPal Client ID - found in your PayPal app settings
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID

# PayPal Client Secret - found in your PayPal app settings
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET

# PayPal Webhook ID - created in your PayPal webhook settings
# Create a webhook at: https://developer.paypal.com/dashboard/webhooks
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# ================================================

# M-Pesa Configuration
# Get these from Safaricom Daraja API: https://developer.safaricom.co.ke/

# M-Pesa Consumer Key from your Daraja app
MPESA_CONSUMER_KEY=YOUR_MPESA_CONSUMER_KEY

# M-Pesa Consumer Secret from your Daraja app
MPESA_CONSUMER_SECRET=YOUR_MPESA_CONSUMER_SECRET

# M-Pesa Shortcode (your paybill or till number)
# Example: 174379 (Safaricom test shortcode)
MPESA_SHORTCODE=YOUR_MPESA_SHORTCODE

# M-Pesa Passkey (provided by Safaricom for STK Push)
# This is different from your app password
MPESA_PASSKEY=YOUR_MPESA_PASSKEY

# M-Pesa Callback URL (where M-Pesa sends webhook events)
# Should point to your /api/mpesa/webhook endpoint
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/webhook

# ================================================

# Application Configuration

# Node environment
NODE_ENV=development

# Application URL (for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database URL (if using one - for transaction logging)
# DATABASE_URL=postgresql://user:password@localhost:5432/payments
